  },
  "93": {
    "id": "93",
    "sourceText": "What has happened?",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">What has happened?</span>",
    "targetText": "Chuyện gì đã xảy ra?"
  },
  "94": {
    "id": "94",
    "sourceText": "What is the situation?",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">What is the situation?</span>",
    "targetText": "Tình hình như thế nào?"
  },
  "95": {
    "id": "95",
    "sourceText": "I have fled domestic abuse from my husband , who has made threats to kill me or have me deported.",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">I have fled domestic abuse from my husband , who has made threats to kill me or have me deported.</span>",
    "targetText": "Tôi đã trốn khỏi bạo lực gia đình của chồng mình, người đã đe dọa giết tôi hoặc trục xuất tôi."
  },
  "96": {
    "id": "96",
    "sourceText": "I have little access to money and I am soon to become homeless .",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">I have little access to money and I am soon to become homeless .</span>",
    "targetText": "Tôi ít có tiền và sắp trở thành người vô gia cư."
  },
  "97": {
    "id": "97",
    "sourceText": "I have three children and I worry about our future , which is causing me significant anxiety.",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">I have three children and I worry about our future , which is causing me significant anxiety.</span>",
    "targetText": "Tôi có ba đứa con và tôi lo lắng về tương lai của chúng tôi, điều này gây ra cho tôi sự lo lắng đáng kể."
  },
  "98": {
    "id": "98",
    "sourceText": "I am currently on a spousal visa, I would like to be granted long -term immigration status of my own right, independent from my husband.",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">I am currently on a spousal visa, I would like to be granted long -term immigration status of my own right, independent from my husband.</span>",
    "targetText": "Tôi hiện đang có visa vợ/chồng, tôi muốn được cấp tình trạng nhập cư dài hạn theo quyền riêng của mình, độc lập với chồng tôi."
  },
  "99": {
    "id": "99",
    "sourceText": "PWP-WhatHappened",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">PWP-WhatHappened</span>",
    "targetText": "PWP-WhatHappened"
  },
  "100": {
    "id": "100",
    "sourceText": "What are your long term goals?",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">What are your long term goals?</span>",
    "targetText": "Mục tiêu dài hạn của bạn là gì?"
