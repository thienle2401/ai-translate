  "83": {
    "id": "83",
    "sourceText": "What do we need to do to make this conversation a good one?",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">What do we need to do to make this conversation a good one?</span>",
    "targetText": "Chúng ta cần làm gì để cuộc nói chuyện này diễn ra tốt đẹp?"
  },
  "84": {
    "id": "84",
    "sourceText": "I do have a reasonable level of English, however it is preferable to use an interpreter particularly with more complex conversations.",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">I do have a reasonable level of English, however it is preferable to use an interpreter particularly with more complex conversations.</span>",
    "targetText": "Tôi có trình độ tiếng Anh hợp lý, nhưng tốt hơn là sử dụng một thông dịch viên, đặc biệt là trong các cuộc trò chuyện phức tạp hơn."
  },
  "85": {
    "id": "85",
    "sourceText": "PWP-ConversationGood",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">PWP-ConversationGood</span>",
    "targetText": "PWP-ConversationGood"
  },
  "86": {
    "id": "86",
    "sourceText": "Details of conversation about consent to share information",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">Details of conversation about consent to share information</span>",
    "targetText": "Chi tiết cuộc trò chuyện về việc đồng ý chia sẻ thông tin"
  },
  "87": {
    "id": "87",
    "sourceText": "I consent for information to be shared with my lawyer and professionals involved within my care.",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">I consent for information to be shared with my lawyer and professionals involved within my care.</span>",
    "targetText": "Tôi đồng ý cho phép thông tin được chia sẻ với luật sư của tôi và các chuyên gia tham gia chăm sóc cho tôi."
  },
  "88": {
    "id": "88",
    "sourceText": "PWP-ConsentToShare",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">PWP-ConsentToShare</span>",
    "targetText": "PWP-Đồng ý chia sẻ"
  },
  "89": {
    "id": "89",
    "sourceText": "What matters to you?",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">What matters to you?</span>",
    "targetText": "Điều gì quan trọng đối với bạn?"
  },
  "90": {
    "id": "90",
    "sourceText": "What do you feel is important for the people working with you to know about you?",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">What do you feel is important for the people working with you to know about you?</span>",
    "targetText": "Bạn cảm thấy điều gì quan trọng mà những người làm việc cùng bạn nên biết về bạn?"
  },
  "91": {
    "id": "91",
    "sourceText": "I have limited support locally .",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">I have limited support locally .</span>",
    "targetText": "Tôi có hỗ trợ hạn chế tại địa phương."
  },
  "92": {
    "id": "92",
    "sourceText": "PWP-WhatIsImportant",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">PWP-WhatIsImportant</span>",
