{
  "169": {
    "id": "169",
    "sourceText": "Who would you like to be contacted?",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">Who would you like to be contacted?</span>",
    "targetText": "Bạn muốn ai được liên lạc?"
  },
  "170": {
    "id": "170",
    "sourceText": "My lawyer",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">My lawyer</span>",
    "targetText": "Luật sư của tôi"
  },
  "171": {
    "id": "171",
    "sourceText": "What would you like to happen if you are unable to make decisions for yourself?",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">What would you like to happen if you are unable to make decisions for yourself?</span>",
    "targetText": "Bạn muốn điều gì xảy ra nếu bạn không thể tự đưa ra quyết định cho mình?"
  },
  "172": {
    "id": "172",
    "sourceText": "I would like my lawyer to make decisions on my behalf if I am unable to.",
    "sourceHTML": "<span class=\"text-node\" data-text-node=\"true\">I would like my lawyer to make decisions on my behalf if I am unable to.</span>",
    "targetText": "Tôi muốn luật sư của tôi thay mặt tôi đưa ra quyết định nếu tôi không thể tự quyết định."
  },
